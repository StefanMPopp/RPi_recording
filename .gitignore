# Python
__pycache__/
*.pyc
.venv/

# App-generated config (machine-specific), its update backup and any
# unreadable copy the app set aside
config_app.yaml
config_app.yaml.*

# Per-rig Ansible config — hardware-specific, exists only on the dev Pi.
# Back these up separately; they are not recoverable from GitHub.
ansible/host_vars/*.yml
!ansible/host_vars/template.yml

# Ansible runtime files
ansible/*.retry

# Read-only GitHub deploy key distributed to recording Pis — a credential,
# exists only on the dev Pi, never committed. See wiki → Set up the dev Pi.
ansible/files/github_deploy_ro
ansible/files/github_deploy_ro.pub

# Recordings
*.avi
*.mp4
*.tiff
*.png

# Archives (patches and bundles are applied, not kept in the repo)
*.zip

# MkDocs build output — the published wiki lives on the gh-pages branch
site/
